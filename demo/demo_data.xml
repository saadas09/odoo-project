<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Demo Rooms -->
        <record id="hotel_room_demo_1" model="hotel.room">
            <field name="name">Deluxe Single Room</field>
            <field name="room_number">101</field>
            <field name="room_type">single</field>
            <field name="price_per_night">75.00</field>
            <field name="capacity">1</field>
            <field name="status">available</field>
        </record>

        <record id="hotel_room_demo_2" model="hotel.room">
            <field name="name">Standard Double Room</field>
            <field name="room_number">102</field>
            <field name="room_type">double</field>
            <field name="price_per_night">120.00</field>
            <field name="capacity">2</field>
            <field name="status">available</field>
        </record>

        <record id="hotel_room_demo_3" model="hotel.room">
            <field name="name">Executive Suite</field>
            <field name="room_number">201</field>
            <field name="room_type">suite</field>
            <field name="price_per_night">250.00</field>
            <field name="capacity">4</field>
            <field name="status">available</field>
        </record>

        <record id="hotel_room_demo_4" model="hotel.room">
            <field name="name">Premium Double Room</field>
            <field name="room_number">103</field>
            <field name="room_type">double</field>
            <field name="price_per_night">150.00</field>
            <field name="capacity">2</field>
            <field name="status">occupied</field>
        </record>

        <record id="hotel_room_demo_5" model="hotel.room">
            <field name="name">Economy Single Room</field>
            <field name="room_number">104</field>
            <field name="room_type">single</field>
            <field name="price_per_night">60.00</field>
            <field name="capacity">1</field>
            <field name="status">maintenance</field>
        </record>

        <!-- Demo Clients -->
        <record id="hotel_client_demo_1" model="hotel.client">
            <field name="name">John Smith</field>
            <field name="email">john.smith@example.com</field>
            <field name="phone">+1-555-0101</field>
            <field name="passport_number">US123456789</field>
        </record>

        <record id="hotel_client_demo_2" model="hotel.client">
            <field name="name">Marie Dupont</field>
            <field name="email">marie.dupont@example.fr</field>
            <field name="phone">+33-6-12-34-56-78</field>
            <field name="passport_number">FR987654321</field>
        </record>

        <record id="hotel_client_demo_3" model="hotel.client">
            <field name="name">Hans Mueller</field>
            <field name="email">hans.mueller@example.de</field>
            <field name="phone">+49-170-1234567</field>
            <field name="passport_number">DE456789123</field>
        </record>

        <!-- Demo Reservations -->
        <record id="hotel_reservation_demo_1" model="hotel.reservation">
            <field name="client_id" ref="hotel_client_demo_1"/>
            <field name="room_id" ref="hotel_room_demo_4"/>
            <field name="check_in" eval="(datetime.now() - timedelta(days=1)).strftime('%Y-%m-%d')"/>
            <field name="check_out" eval="(datetime.now() + timedelta(days=2)).strftime('%Y-%m-%d')"/>
            <field name="status">confirmed</field>
        </record>

        <record id="hotel_reservation_demo_2" model="hotel.reservation">
            <field name="client_id" ref="hotel_client_demo_2"/>
            <field name="room_id" ref="hotel_room_demo_3"/>
            <field name="check_in" eval="(datetime.now() + timedelta(days=5)).strftime('%Y-%m-%d')"/>
            <field name="check_out" eval="(datetime.now() + timedelta(days=10)).strftime('%Y-%m-%d')"/>
            <field name="status">confirmed</field>
        </record>

        <record id="hotel_reservation_demo_3" model="hotel.reservation">
            <field name="client_id" ref="hotel_client_demo_3"/>
            <field name="room_id" ref="hotel_room_demo_1"/>
            <field name="check_in" eval="(datetime.now() + timedelta(days=15)).strftime('%Y-%m-%d')"/>
            <field name="check_out" eval="(datetime.now() + timedelta(days=18)).strftime('%Y-%m-%d')"/>
            <field name="status">draft</field>
        </record>

    </data>
</odoo>
