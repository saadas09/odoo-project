<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for Hotel Clients -->
    <record id="view_hotel_client_tree" model="ir.ui.view">
        <field name="name">hotel.client.tree</field>
        <field name="model">hotel.client</field>
        <field name="arch" type="xml">
            <tree string="Hotel Clients">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="passport_number"/>
                <field name="reservation_count"/>
            </tree>
        </field>
    </record>

    <!-- Form View for Hotel Clients -->
    <record id="view_hotel_client_form" model="ir.ui.view">
        <field name="name">hotel.client.form</field>
        <field name="model">hotel.client</field>
        <field name="arch" type="xml">
            <form string="Hotel Client">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_hotel_reservation)d" 
                                type="action" 
                                class="oe_stat_button" 
                                icon="fa-calendar"
                                context="{'search_default_client_id': active_id, 'default_client_id': active_id}">
                            <field name="reservation_count" widget="statinfo" string="Reservations"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Client Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group>
                            <field name="passport_number"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reservations" name="reservations">
                            <field name="reservation_ids">
                                <tree string="Reservations" decoration-success="status=='confirmed'" decoration-muted="status=='cancelled'">
                                    <field name="name"/>
                                    <field name="room_number"/>
                                    <field name="check_in"/>
                                    <field name="check_out"/>
                                    <field name="nights"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="total_price" widget="monetary"/>
                                    <field name="status" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View for Hotel Clients -->
    <record id="view_hotel_client_search" model="ir.ui.view">
        <field name="name">hotel.client.search</field>
        <field name="model">hotel.client</field>
        <field name="arch" type="xml">
            <search string="Search Clients">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="passport_number"/>
            </search>
        </field>
    </record>

    <!-- Kanban View for Hotel Clients -->
    <record id="view_hotel_client_kanban" model="ir.ui.view">
        <field name="name">hotel.client.kanban</field>
        <field name="model">hotel.client</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="reservation_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <span class="o_kanban_record_subtitle">
                                        <field name="email"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span><field name="phone"/></span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span><field name="reservation_count"/> reservations</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action for Hotel Clients -->
    <record id="action_hotel_client" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">hotel.client</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first client
            </p>
            <p>
                Register clients with their contact information and track their reservations.
            </p>
        </field>
    </record>

</odoo>
