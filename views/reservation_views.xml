<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server Actions for API Synchronization - Define FIRST -->
    <record id="action_sync_booking_reservations" model="ir.actions.server">
        <field name="name">Sync Booking.com Reservations</field>
        <field name="model_id" ref="model_api_synchronization"/>
        <field name="state">code</field>
        <field name="code">
model.sync_booking_reservations()
action = {
    'type': 'ir.actions.client',
    'tag': 'display_notification',
    'params': {
        'title': 'Booking.com Sync',
        'message': 'Synchronization started. Check API Synchronization logs for results.',
        'type': 'success',
        'sticky': False,
    }
}
        </field>
    </record>

    <record id="action_sync_airbnb_reservations" model="ir.actions.server">
        <field name="name">Sync Airbnb Reservations</field>
        <field name="model_id" ref="model_api_synchronization"/>
        <field name="state">code</field>
        <field name="code">
model.sync_airbnb_reservations()
action = {
    'type': 'ir.actions.client',
    'tag': 'display_notification',
    'params': {
        'title': 'Airbnb Sync',
        'message': 'Synchronization started. Check API Synchronization logs for results.',
        'type': 'success',
        'sticky': False,
    }
}
        </field>
    </record>

    <!-- Tree View for Hotel Reservations -->
    <record id="view_hotel_reservation_tree" model="ir.ui.view">
        <field name="name">hotel.reservation.tree</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <tree string="Hotel Reservations" decoration-success="status=='confirmed'" decoration-muted="status=='cancelled'" decoration-info="status=='draft'">
                <field name="name"/>
                <field name="client_name"/>
                <field name="room_number"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="nights"/>
                <field name="currency_id" invisible="1"/>
                <field name="total_price" widget="monetary"/>
                <field name="status" widget="badge" decoration-success="status=='confirmed'" decoration-danger="status=='cancelled'" decoration-info="status=='draft'"/>
            </tree>
        </field>
    </record>

    <!-- Form View for Hotel Reservations -->
    <record id="view_hotel_reservation_form" model="ir.ui.view">
        <field name="name">hotel.reservation.form</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <form string="Hotel Reservation">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" states="draft" class="oe_highlight" attrs="{'invisible': [('status', '!=', 'draft')]}"/>
                    <button name="action_cancel" string="Cancel" type="object" states="draft,confirmed" class="btn-secondary" attrs="{'invisible': [('status', 'not in', ['draft', 'confirmed'])]}"/>
                    <button name="action_set_to_draft" string="Set to Draft" type="object" states="cancelled" class="btn-secondary" attrs="{'invisible': [('status', '!=', 'cancelled')]}"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_hotel_room)d" 
                                type="action" 
                                class="oe_stat_button" 
                                icon="fa-bed"
                                context="{'search_default_id': room_id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View Room</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="client_id" options="{'no_create': True}"/>
                            <field name="client_email" readonly="1"/>
                            <field name="room_id" options="{'no_create': True}"/>
                            <field name="room_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="nights" readonly="1"/>
                            <field name="price_per_night" readonly="1" widget="monetary"/>
                            <field name="total_price" readonly="1" widget="monetary" class="oe_subtotal_footer_separator"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View for Hotel Reservations -->
    <record id="view_hotel_reservation_search" model="ir.ui.view">
        <field name="name">hotel.reservation.search</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <search string="Search Reservations">
                <field name="name"/>
                <field name="client_id"/>
                <field name="room_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('status', '=', 'confirmed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('status', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Current" name="current" domain="[('check_in', '&lt;=', context_today().strftime('%Y-%m-%d')), ('check_out', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Upcoming" name="upcoming" domain="[('check_in', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Past" name="past" domain="[('check_out', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Client" name="group_client" context="{'group_by': 'client_id'}"/>
                    <filter string="Room" name="group_room" context="{'group_by': 'room_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Check-in Date" name="group_check_in" context="{'group_by': 'check_in'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Calendar View for Hotel Reservations -->
    <record id="view_hotel_reservation_calendar" model="ir.ui.view">
        <field name="name">hotel.reservation.calendar</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <calendar string="Reservations" date_start="check_in" date_stop="check_out" color="room_id" mode="month">
                <field name="client_name"/>
                <field name="room_number"/>
                <field name="status"/>
            </calendar>
        </field>
    </record>

    <!-- Kanban View for Hotel Reservations -->
    <record id="view_hotel_reservation_kanban" model="ir.ui.view">
        <field name="name">hotel.reservation.kanban</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="client_name"/>
                <field name="room_number"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="total_price"/>
                <field name="currency_id"/>
                <field name="status"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <span class="o_kanban_record_subtitle">
                                        <field name="client_name"/> - Room <field name="room_number"/>
                                    </span>
                                </div>
                                <field name="status" widget="badge" decoration-success="status=='confirmed'" decoration-danger="status=='cancelled'" decoration-info="status=='draft'"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="check_in"/> to <field name="check_out"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_right">
                                    <span><field name="total_price" widget="monetary"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Pivot View for Hotel Reservations -->
    <record id="view_hotel_reservation_pivot" model="ir.ui.view">
        <field name="name">hotel.reservation.pivot</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <pivot string="Reservations Analysis">
                <field name="check_in" type="row" interval="month"/>
                <field name="room_type" type="col"/>
                <field name="total_price" type="measure"/>
                <field name="nights" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View for Hotel Reservations -->
    <record id="view_hotel_reservation_graph" model="ir.ui.view">
        <field name="name">hotel.reservation.graph</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <graph string="Reservations Statistics" type="bar">
                <field name="check_in" interval="month"/>
                <field name="total_price" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action for Hotel Reservations -->
    <record id="action_hotel_reservation" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">hotel.reservation</field>
        <field name="view_mode">tree,kanban,form,calendar,pivot,graph</field>
        <field name="context">{'search_default_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first reservation
            </p>
            <p>
                Manage hotel reservations with automatic price calculation and conflict prevention.
            </p>
        </field>
    </record>

</odoo>
