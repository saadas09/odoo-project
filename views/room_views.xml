<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for Hotel Rooms -->
    <record id="view_hotel_room_tree" model="ir.ui.view">
        <field name="name">hotel.room.tree</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <tree string="Hotel Rooms" decoration-success="status=='available'" decoration-danger="status=='maintenance'" decoration-warning="status=='occupied'">
                <field name="name"/>
                <field name="room_number"/>
                <field name="room_type"/>
                <field name="currency_id" invisible="1"/>
                <field name="price_per_night" widget="monetary"/>
                <field name="capacity"/>
                <field name="status" widget="badge" decoration-success="status=='available'" decoration-danger="status=='maintenance'" decoration-warning="status=='occupied'"/>
            </tree>
        </field>
    </record>

    <!-- Form View for Hotel Rooms -->
    <record id="view_hotel_room_form" model="ir.ui.view">
        <field name="name">hotel.room.form</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form string="Hotel Room">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="available,occupied,maintenance"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Room Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="room_number"/>
                            <field name="room_type"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="price_per_night" widget="monetary"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reservations" name="reservations">
                            <field name="reservation_ids">
                                <tree string="Reservations" decoration-success="status=='confirmed'" decoration-muted="status=='cancelled'">
                                    <field name="name"/>
                                    <field name="client_name"/>
                                    <field name="check_in"/>
                                    <field name="check_out"/>
                                    <field name="nights"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="total_price" widget="monetary"/>
                                    <field name="status" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View for Hotel Rooms -->
    <record id="view_hotel_room_search" model="ir.ui.view">
        <field name="name">hotel.room.search</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <search string="Search Rooms">
                <field name="name"/>
                <field name="room_number"/>
                <field name="room_type"/>
                <separator/>
                <filter string="Available" name="available" domain="[('status', '=', 'available')]"/>
                <filter string="Occupied" name="occupied" domain="[('status', '=', 'occupied')]"/>
                <filter string="Maintenance" name="maintenance" domain="[('status', '=', 'maintenance')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Room Type" name="group_room_type" context="{'group_by': 'room_type'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View for Hotel Rooms -->
    <record id="view_hotel_room_kanban" model="ir.ui.view">
        <field name="name">hotel.room.kanban</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="room_number"/>
                <field name="room_type"/>
                <field name="price_per_night"/>
                <field name="currency_id"/>
                <field name="status"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <span class="o_kanban_record_subtitle">
                                        Room <field name="room_number"/> - <field name="room_type"/>
                                    </span>
                                </div>
                                <field name="status" widget="badge" decoration-success="status=='available'" decoration-danger="status=='maintenance'" decoration-warning="status=='occupied'"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span><field name="price_per_night" widget="monetary"/>/night</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action for Hotel Rooms -->
    <record id="action_hotel_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_available': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first hotel room
            </p>
            <p>
                Define rooms with their characteristics: type, capacity, and price per night.
            </p>
        </field>
    </record>

</odoo>
